---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, absolute, formatDate, postPath, readingTime, sortPosts } from "../../lib/site";
import { sourceNames, topicLabels } from "../../lib/topics";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      newer: index > 0 ? posts[index - 1] : null,
      older: index < posts.length - 1 ? posts[index + 1] : null,
    },
  }));
}

/** Hostname for the Sources list ("www." stripped), empty when unusable. */
function domain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const origin = Astro.site ?? new URL("https://example.com");
const image = `/og/${post.data.slug}.png`;
const sourceItems = post.data.sources ?? [];
// A post written without sources (the welcome note) is not a data post: it gets
// no sources line and no reading-time claim.
const hasSources = sourceItems.length > 0;
const minutes = readingTime(post.body ?? "");
const sources = sourceNames(post);
const topics = topicLabels(post);

/**
 * The engine appends its own Sources section to the markdown body. This page
 * renders that list from structured frontmatter instead, so the trailing copy
 * is hidden (CSS-only, see `.prose--body-sources`). Only applied when the body
 * really does end with its Sources section, so nothing else is ever hidden.
 */
const bodyHasSourcesSection = /\n## Sources\s*\n[\s\S]*$/.test(post.body ?? "");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { "@type": "Organization", name: SITE.author },
  publisher: { "@type": "Organization", name: SITE.title },
  mainEntityOfPage: absolute(origin, postPath(post.data.slug)),
  image: absolute(origin, image),
  isAccessibleForFree: true,
  keywords: topics.join(", "),
  citation: sourceItems.map((source) => ({
    "@type": "CreativeWork",
    name: source.title,
    url: source.url,
  })),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={image}
  type="article"
  publishedTime={post.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <article class="article">
    <header>
      <h1 class="article__title">{post.data.title}</h1>
      <div class="meta article__meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {hasSources && <span>{minutes} min read</span>}
        {sources.length > 0 && <span>Sources: {sources.join(", ")}</span>}
      </div>
    </header>

    <div class:list={["prose", bodyHasSourcesSection && "prose--body-sources"]}>
      <Content />
    </div>

    {hasSources && (
      <section class="sources" aria-labelledby="sources-heading">
        <h2 class="sources__label" id="sources-heading">Sources</h2>
        <ol class="sources__list">
          {sourceItems.map((source) => {
            const host = domain(source.url);
            return (
              <li>
                <a href={source.url}>{source.title || host || "Source"}</a>
                {host && <span class="sources__domain">{host}</span>}
              </li>
            );
          })}
        </ol>
      </section>
    )}

    <nav class="post-nav" aria-label="Post navigation">
      {newer ? (
        <a href={postPath(newer.data.slug)}><span>Newer</span>{newer.data.title}</a>
      ) : (
        <span />
      )}
      {older ? (
        <a href={postPath(older.data.slug)}><span>Older</span>{older.data.title}</a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</BaseLayout>
