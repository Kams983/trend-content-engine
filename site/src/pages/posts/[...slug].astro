---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, absolute, formatDate, postPath, readingTime, sortPosts } from "../../lib/site";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      newer: index > 0 ? posts[index - 1] : null,
      older: index < posts.length - 1 ? posts[index + 1] : null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const origin = Astro.site ?? new URL("https://example.com");
const image = `/og/${post.data.slug}.png`;
const minutes = readingTime(post.body ?? "");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { "@type": "Organization", name: SITE.author },
  publisher: { "@type": "Organization", name: SITE.title },
  mainEntityOfPage: absolute(origin, postPath(post.data.slug)),
  image: absolute(origin, image),
  isAccessibleForFree: true,
  keywords: post.data.tags.join(", "),
  citation: post.data.sources.map((source) => ({
    "@type": "CreativeWork",
    name: source.title,
    url: source.url,
  })),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={image}
  type="article"
  publishedTime={post.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <p class="article-header__desc">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{minutes} min read</span>
        {post.data.tags.length > 0 && (
          <ul class="tags">
            {post.data.tags.map((tag) => <li><a href={`/tags/${tag}`}>{tag}</a></li>)}
          </ul>
        )}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <aside class="disclosure" aria-label="How this article was made">
      {post.data.ai_assisted ? (
        <>
          <p>
            <strong>AI-assisted article.</strong> This piece was drafted by a language model from the
            {" "}
            {post.data.sources.length}
            {" "}
            source{post.data.sources.length === 1 ? "" : "s"} listed above, then automatically checked
            for length, cited URLs and placeholder text before publishing.
          </p>
          <p>Every fact should be traceable to one of those sources — verify anything important there.</p>
        </>
      ) : (
        <>
          <p>
            <strong>Written by a person.</strong> This post was not generated by the engine and is not
            marked as AI-assisted.
          </p>
          <p>The daily articles are machine-drafted; this one explains how that works.</p>
        </>
      )}
    </aside>

    <nav class="post-nav" aria-label="Post navigation">
      {newer ? (
        <a href={postPath(newer.data.slug)}><span>Newer</span>{newer.data.title}</a>
      ) : (
        <span />
      )}
      {older ? (
        <a href={postPath(older.data.slug)}><span>Older</span>{older.data.title}</a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</BaseLayout>
