---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadStory from "../components/LeadStory.astro";
import EarlierList from "../components/EarlierList.astro";
import { SITE, sortPosts } from "../lib/site";

const posts = sortPosts(await getCollection("posts"));
const [latest, ...earlier] = posts;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  {latest ? (
    <>
      <LeadStory post={latest} />
      {earlier.length > 0 && <EarlierList posts={earlier} />}
    </>
  ) : (
    <>
      <h1 class="visually-hidden">{SITE.title}</h1>
      <p class="empty">No articles yet. The first scheduled run publishes here.</p>
    </>
  )}
</BaseLayout>
