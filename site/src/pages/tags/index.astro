---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, allTags, sortPosts } from "../../lib/site";

const posts = sortPosts(await getCollection("posts"));
const tags = allTags(posts);
---

<BaseLayout title="Topics" description={`Every topic covered by ${SITE.title}, with post counts.`}>
  <section>
    <div class="section-head">
      <h1>Topics</h1>
      <span class="section-head__count">{tags.length} tags</span>
    </div>

    {tags.length === 0 ? (
      <p class="empty">No topics yet.</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <li>
            <a class="tag-chip" href={`/tags/${tag}`}>{tag} · {count}</a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
