---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE, allTags, postsWithTag, sortPosts } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return allTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = postsWithTag(sortPosts(await getCollection("posts")), tag);
---

<BaseLayout
  title={`Posts tagged “${tag}”`}
  description={`${posts.length} post${posts.length === 1 ? "" : "s"} tagged “${tag}” on ${SITE.title}.`}
>
  <section>
    <div class="section-head">
      <h1>{tag}</h1>
      <span class="section-head__count">
        {posts.length} {posts.length === 1 ? "post" : "posts"} · <a href="/tags">all topics</a>
      </span>
    </div>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
