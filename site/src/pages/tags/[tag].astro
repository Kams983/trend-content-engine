---
import { getCollection } from "astro:content";
import { absolute, allTags } from "../../lib/site";
import { TOPIC_LABELS, topicHref } from "../../lib/topics";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return allTags(posts).map(({ tag }) => {
    const label = TOPIC_LABELS[tag];
    return { params: { tag }, props: { to: label ? topicHref(label) : "/topics" } };
  });
}

// Old tag URLs stay reachable. A source tag (arxiv, hackernews) has no topic
// page to land on, so it redirects to the topic index instead of a dead end.
const { to } = Astro.props;
const origin = Astro.site ?? new URL("https://example.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Moved</title>
    <link rel="canonical" href={absolute(origin, to)} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
