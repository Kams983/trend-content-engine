---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, byYear, formatDateShort, postPath, sortPosts } from "../lib/site";

const posts = sortPosts(await getCollection("posts"));
const years = byYear(posts);
---

<BaseLayout title="Archive" description={`Every article published by ${SITE.title}, newest first.`}>
  <h1 class="page-title">Archive</h1>

  {years.length === 0 ? (
    <p class="empty">Nothing archived yet.</p>
  ) : (
    years.map(({ year, posts: items }) => (
      <section class="year">
        <h2 class="year__label">{year}</h2>
        <ul class="year__list">
          {items.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time>
              <a href={postPath(post.data.slug)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</BaseLayout>
