---
import type { Overview } from "../lib/overview";

interface Props {
  overview: Overview;
}

const { overview } = Astro.props;
const tiles = [
  {
    value: overview.articleCount,
    label: "articles published",
    context: `on ${overview.publicationDays} of ${overview.windowDays} days`,
  },
  {
    value: overview.sourceCount,
    label: "sources cited",
    context: `${overview.sourcesPerArticle.toFixed(1)} per article`,
  },
  {
    value: overview.topicCount,
    label: "topics covered",
    context: overview.topTopic ? `most covered: ${overview.topTopic}` : "no topics yet",
  },
];
---

<ul class="tiles">
  {tiles.map((tile) => (
    <li class="tile">
      <span class="tile__value">{tile.value}</span>
      <span class="tile__label">{tile.label}</span>
      <span class="tile__context">{tile.context}</span>
    </li>
  ))}
</ul>
