---
// Optional, privacy-friendly analytics. Nothing is loaded when the token is
// unset (PUBLIC_CF_ANALYTICS_TOKEN), so local builds and CI stay clean.
const token = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

{token && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token })}
  ></script>
)}
