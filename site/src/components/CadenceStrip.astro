---
import type { DayMark } from "../lib/overview";

interface Props {
  days: DayMark[];
  windowLabel: string;
  label: string;
}

const { days, windowLabel, label } = Astro.props;
const max = Math.max(1, ...days.map((day) => day.sources));
const tickHeight = (day: DayMark) => Math.max(4, Math.round((day.sources / max) * 28));
---

<figure class="board__strip">
  <figcaption class="board__strip-caption">The last {days.length} days, {windowLabel}</figcaption>
  <div class="strip" role="img" aria-label={label}>
    {days.map((day) => (
      <span class="strip__col">
        <span
          class:list={[
            "strip__tick",
            day.articles > 0 ? "strip__tick--published" : "strip__tick--quiet",
          ]}
          style={day.articles > 0 ? `height:${tickHeight(day)}px` : undefined}
        ></span>
        <span class="strip__day" aria-hidden="true">{day.weekday}</span>
      </span>
    ))}
  </div>
</figure>
