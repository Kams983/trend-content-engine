---
import type { Post } from "../lib/site";
import { formatDateShort, postPath, readingTime } from "../lib/site";

interface Props {
  post: Post;
  /** Adds the source count and reading time to the meta line (home board). */
  showMetrics?: boolean;
}

const { post, showMetrics = false } = Astro.props;
const href = postPath(post.data.slug);
const sourceCount = post.data.sources.length;
const sourceLabel =
  sourceCount === 0 ? "no sources" : sourceCount === 1 ? "1 source" : `${sourceCount} sources`;
---

<li class="post-row">
  {showMetrics ? (
    <p class="post-row__metrics">
      <time datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time>
      <span>{sourceLabel}</span>
      <span>{readingTime(post.body ?? "")} min read</span>
    </p>
  ) : (
    <time class="post-row__date" datetime={post.data.date.toISOString()}>
      {formatDateShort(post.data.date)}
    </time>
  )}
  <h2 class="post-row__title"><a href={href}>{post.data.title}</a></h2>
  <p class="post-row__teaser">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="tags post-row__tags">
      {post.data.tags.slice(0, 4).map((tag) => <li><a href={`/tags/${tag}`}>{tag}</a></li>)}
    </ul>
  )}
</li>
