---
import type { Post } from "../lib/site";
import { formatDateShort, postPath, readingTime } from "../lib/site";
import { sourceNames } from "../lib/topics";

interface Props {
  posts: Post[];
  heading?: string;
  /** Appends the "All articles in the archive" link (home page only). */
  archiveLink?: boolean;
}

const { posts, heading = "Earlier", archiveLink = true } = Astro.props;

const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`;
---

<section class="earlier" aria-labelledby="earlier-heading">
  <h2 class="label" id="earlier-heading">{heading}</h2>
  <ul class="earlier__list">
    {posts.map((post) => {
      const hasSources = (post.data.sources ?? []).length > 0;
      const minutes = readingTime(post.body ?? "");
      const sources = sourceNames(post);
      return (
        <li class="row">
          <time class="row__date" datetime={post.data.date.toISOString()}>
            {formatDateShort(post.data.date)}
          </time>
          <div class="row__body">
            <h3 class="row__title"><a href={postPath(post.data.slug)}>{post.data.title}</a></h3>
            <p class="row__teaser">{post.data.description}</p>
            {hasSources && (
              <p class="row__meta">
                {minutes} min read · {plural((post.data.sources ?? []).length, "source")}
                {sources.length > 0 && ` · ${sources.join(", ")}`}
              </p>
            )}
          </div>
        </li>
      );
    })}
  </ul>
  {archiveLink && (
    <p class="earlier__more"><a class="text-link" href="/archive">All articles in the archive</a></p>
  )}
</section>
