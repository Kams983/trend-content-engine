---
import type { BoardSource } from "../lib/overview";

interface Props {
  sources: BoardSource[];
  total: number;
  articles: number;
}

const { sources, total, articles } = Astro.props;
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`;
---

<section class="panel" aria-labelledby="sources-heading">
  <div class="panel__head">
    <h2 class="label" id="sources-heading">Where it came from</h2>
  </div>
  <ul class="src-list">
    {sources.map((source, index) => (
      <li
        class:list={["src", index === 0 && "src--lead"]}
        data-source={source.name}
        data-count={source.count}
      >
        <div class="src__head">
          <span>{source.name}</span>
          <span class="src__count">{source.count}</span>
        </div>
        <div class="src__track">
          <span class="src__bar" style={`width:${source.widthPct}%`}></span>
        </div>
      </li>
    ))}
  </ul>
  <p class="src-list__total">{plural(total, "source")} across {plural(articles, "article")}</p>
</section>
