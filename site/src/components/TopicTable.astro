---
import type { TopicRow } from "../lib/overview";
import { formatDayShort } from "../lib/site";

interface Props {
  rows: TopicRow[];
}

const { rows } = Astro.props;
const summary = (row: TopicRow) =>
  `${row.posts} post${row.posts === 1 ? "" : "s"} · ${formatDayShort(row.lastDate)}`;
---

<section class="card card--topics">
  <div class="card__head">
    <h2 class="card__title">What&rsquo;s rising</h2>
    <a class="card__link" href="/tags">All topics →</a>
  </div>
  <table class="topics">
    <thead>
      <tr>
        <th scope="col">Topic</th>
        <th scope="col">Articles</th>
        <th scope="col">Last covered</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="topic-row">
          <td class="topics__topic"><a href={`/tags/${row.tag}`}>{row.tag}</a></td>
          <td class="topics__num">{row.posts}</td>
          <td class="topics__date">{formatDayShort(row.lastDate)}</td>
          <td class="topics__summary">{summary(row)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>
