---
import { SITE, absolute } from "../lib/site";
const year = new Date().getUTCFullYear();
const origin = Astro.site ?? new URL("https://example.com");
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p>
      Every article is drafted by a language model from the sources it lists, then checked for length,
      citations and placeholders before a person approves it.
    </p>
    <p>
      © {year} {SITE.author} ·
      <a href="/about">About</a> ·
      <a href={absolute(origin, "/rss.xml")}>RSS</a>
    </p>
  </div>
</footer>
