# ---------------------------------------------------------------------------
# Trend Content Engine — environment template
# Copy to .env and fill in. .env is gitignored; never commit real values.
# Names only here — no real secrets.
# ---------------------------------------------------------------------------

# --- Run mode -------------------------------------------------------------
# REQUIRE_APPROVAL: drafts wait for an approve/reject callback in Telegram (default true).
REQUIRE_APPROVAL=true
# DRY_RUN: run the whole pipeline but send/post nothing (prints what it would send).
DRY_RUN=false
# RUN_MODE: draft | publish | full  (draft = stage A, publish = stage B, full = both)
RUN_MODE=full
# USE_FIXTURES: skip live ingest and read src/ingest/fixtures/*.json instead.
USE_FIXTURES=false
# DB_PATH: SQLite file for run_log / articles / publications / topics.
DB_PATH=trend_store.sqlite
# CONTENT_POSTS_DIR: where markdown posts are written for the Astro site.
CONTENT_POSTS_DIR=site/content/posts

# --- LLM (Groq, OpenAI-compatible) ---------------------------------------
# Required unless you run `--use-fixtures --dry-run` (offline stub LLM).
GROQ_API_KEY=
# GROQ_MODEL: primary chat model.
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK: used after retryable failures on the primary model.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_TIMEOUT=60
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048
GROQ_MAX_ATTEMPTS=3

# --- Public site ----------------------------------------------------------
# SITE_URL: absolute base URL, no trailing slash (e.g. https://trend.example.com).
SITE_URL=

# --- Public brand (what readers see) -------------------------------------
# The engine itself is "TCE"; the publication it produces is "Upwire". These two
# values are the single source of truth for every public surface (site, meta,
# social posts). Override the name to rebrand without touching any code — the
# site reads the matching PUBLIC_* pair, which defaults to the same values.
BRAND_NAME=Upwire
BRAND_TAGLINE=What's rising in tech and AI, with sources.

# --- Feature flags (social targets) --------------------------------------
ENABLE_BLUESKY=false
ENABLE_TELEGRAM_CHANNEL=false
ENABLE_DEVTO=false
ENABLE_HASHNODE=false
ENABLE_MASTODON=false

# --- Bluesky (atproto) ----------------------------------------------------
# BLUESKY_HANDLE: e.g. yourhandle.bsky.social
BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD: an app password from Settings → App Passwords (never the account password).
BLUESKY_APP_PASSWORD=

# --- Telegram -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN: from @BotFather.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID: destination channel (e.g. @yourchannel or -1001234567890).
TELEGRAM_CHANNEL_ID=
# TELEGRAM_ADMIN_CHAT_ID: your personal chat id — receives drafts for approval and failure alerts.
TELEGRAM_ADMIN_CHAT_ID=

# --- DEV.to (Forem) -------------------------------------------------------
# DEVTO_API_KEY: https://dev.to/settings/extensions → DEV API Keys.
DEVTO_API_KEY=

# --- Hashnode (optional, default off) ------------------------------------
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=

# --- Mastodon (optional, default off) ------------------------------------
# MASTODON_INSTANCE: base URL of your instance, no trailing slash (e.g. https://mastodon.social).
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=

# --- Ingest ---------------------------------------------------------------
# GITHUB_TOKEN: raises the GitHub Search API rate limit (no scopes needed for public search).
GITHUB_TOKEN=
USER_AGENT=TrendContentEngine/1.0
HN_LIMIT=30
ARXIV_LIMIT=30
# ARXIV_POLITENESS_DELAY: seconds between arXiv requests (their guidance: ~1 req / 3s).
ARXIV_POLITENESS_DELAY=3
GITHUB_LIMIT=30
REDDIT_LIMIT=30
# MIN_SOURCES_WITH_DATA: below this many live sources the run is SKIPPED_NO_DATA.
MIN_SOURCES_WITH_DATA=2

# --- Analysis / scoring ---------------------------------------------------
# CLUSTER_THRESHOLD: cosine distance cut-off for clustering (0.40 tuned on the bundled fixtures).
CLUSTER_THRESHOLD=0.40
# TOPIC_SIMILARITY_THRESHOLD: cosine similarity needed to match a previous topic centroid.
TOPIC_SIMILARITY_THRESHOLD=0.6
TOPIC_LOOKBACK_DAYS=14
TOPIC_RETENTION_DAYS=60
MIN_CLUSTER_ITEMS=3
MIN_CLUSTER_SOURCES=2
COOLDOWN_DAYS=7
COOLDOWN_VELOCITY_OVERRIDE=2.0
TOP_CLUSTERS=10
MAX_DRAFT_ATTEMPTS=3
SCORE_W_VELOCITY=1.0
SCORE_W_NOVELTY=1.2
SCORE_W_SIZE=1.0
SCORE_W_SOURCES=1.0
SCORE_W_ENGAGEMENT=0.8

# --- Article validation ---------------------------------------------------
ARTICLE_MIN_WORDS=400
ARTICLE_MAX_WORDS=800
TITLE_MAX_LEN=120
TEASER_MAX_LEN=280

# --- Site build (Astro, public — never put secrets in PUBLIC_*) ----------
# PUBLIC_BRAND_NAME / PUBLIC_BRAND_TAGLINE: what the built site shows. Default to
# the same values as BRAND_NAME / BRAND_TAGLINE above.
PUBLIC_BRAND_NAME=Upwire
PUBLIC_BRAND_TAGLINE=What's rising in tech and AI, with sources.
# PUBLIC_CF_ANALYTICS_TOKEN: Cloudflare Web Analytics beacon token (optional).
PUBLIC_CF_ANALYTICS_TOKEN=
# PUBLIC_BUTTONDOWN_USERNAME: Buttondown username for the subscribe form (optional).
PUBLIC_BUTTONDOWN_USERNAME=
